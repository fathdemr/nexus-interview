{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API for the Nexus AI-driven interview platform.\n\nAuthentication: protected endpoints accept a JWT either as an `Authorization: Bearer {token}` header\nor as the HttpOnly `access_token` cookie set by the auth endpoints. In Swagger UI, click Authorize and enter `Bearer {token}`.\n\nEvery response is wrapped in the standard envelope `{ success, message, code, data }`.\nOn 4xx/5xx responses the `message` field may be masked with a reference ID.",
        "title": "Nexus Interview API",
        "contact": {
            "name": "Nexus Team"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/admin/healthcheck": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Runs the admin service healthcheck (database and cache connectivity). Intended for authenticated\noperators and readiness probes that hold a token; use the public /healthcheck for plain liveness.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Admin"
                ],
                "summary": "Dependency healthcheck",
                "responses": {
                    "200": {
                        "description": "OK — all dependencies reachable",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR — one or more dependencies unhealthy",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Invalidates the refresh token stored for the authenticated actor so it can no longer be used to mint\nnew access tokens, then expires the `access_token` and `refresh_token` cookies in the browser.\nThe current access token stays valid until its natural expiry.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Logout",
                "responses": {
                    "200": {
                        "description": "logged out — cookies cleared",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED — missing or invalid access token",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "description": "Reads the `refresh_token` HttpOnly cookie (scoped to /api/v1/auth), validates it against the token store,\nand issues a brand-new access/refresh pair. Both tokens are written back as HttpOnly cookies;\nthe response body carries no token. If the refresh token is unknown or expired the cookies are cleared\nand the client must log in again.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh access token",
                "responses": {
                    "200": {
                        "description": "tokens refreshed — new cookies set",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED — refresh cookie missing, invalid or expired",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    }
                }
            }
        },
