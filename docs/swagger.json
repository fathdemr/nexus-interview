                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "409": {
                        "description": "ALREADY_EXISTS — a candidate with this email already exists",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/github_com_fathdemr_nexus-interview_pkg_httputil.BaseServiceResponse"
                        }
                    }
                }
            }
        },
